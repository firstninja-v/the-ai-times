# --- Small model (OpenAI-compatible) ---
# Works with OpenAI, Groq, Together, OpenRouter, Fireworks, Ollama (/v1), etc.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Examples:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# --- Newspaper generation ---
PAPER_TITLE=The AI Times
NEWSPAPER_TEMPLATE=classic
NEWSPAPER_PAGES=4
NEWSPAPER_MAX_ARTICLES=12
NEWSPAPER_EMAIL_TO=you@example.com
PAPER_COMPANY=
NEWSPAPER_USE_LLM=1

# --- SMTP email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=The AI Times <news@example.com>
