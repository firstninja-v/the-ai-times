# Optional SMTP — without these, emails are mocked / previewed locally.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="The AI Times <news@example.com>"
NEWSPAPER_EMAIL_TO=you@example.com

# Small model (OpenAI-compatible). Any smaller hosted model works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Newspaper studio defaults
PAPER_TITLE=The AI Times
NEWSPAPER_TEMPLATE=classic
NEWSPAPER_PAGES=4
