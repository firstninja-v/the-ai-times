{
  "name": "ai-times",
  "version": "0.1.0",
  "private": true,
  "description": "Wake up to a printed paper, not a feed. Interest-matched morning newspaper with daily email, Wi-Fi/AirPrint agents, and pause/resume when you're away.",
  "homepage": "https://github.com/firstninja-v/the-ai-times",
  "repository": {
    "type": "git",
    "url": "https://github.com/firstninja-v/the-ai-times.git"
  },
  "keywords": [
    "newspaper",
    "rss",
    "nextjs",
    "python",
    "airprint",
    "automation",
    "self-hosted",
    "morning-routine"
  ],
  "scripts": {
    "dev": "next dev --port 43123",
    "build": "next build",
    "start": "next start --port 43123",
    "lint": "next lint",
    "print-agent": "node scripts/print-agent.mjs",
    "agent:news": "python3 agents/news_agent.py",
    "agent:print": "python3 agents/print_daemon.py",
    "agent:morning": "python3 agents/morning_daemon.py",
    "agent:morning:once": "python3 agents/morning_daemon.py --once",
    "agent:paper": "python3 -m agents.newspaper",
    "agent:paper:daily": "python3 -m agents.newspaper.daily",
    "agent:paper:previews": "python3 -m agents.newspaper.previews --all",
    "agents:install": "pip3 install -r agents/requirements.txt"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "playwright-core": "^1.64.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
